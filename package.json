{
  "name": "news-article-assignment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Two-page news article CRUD application \u2014 React 19, TypeScript, Express and SQLite",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/contracts",
    "packages/api",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @news/api",
    "dev:web": "npm run dev --workspace @news/web",
    "build": "npm run build --workspace @news/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:e2e": "npm run test:e2e --workspace @news/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
