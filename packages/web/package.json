{
  "name": "@news/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React 19 client — Vite, MUI, React Router, RTK Query over Axios",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
