{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Explicit under TypeScript 6, which defaults `types` to [].
    // "node" is required by vite.config.ts, which is inside this project.
    "types": ["vite/client", "node"],
    // No `baseUrl` — deprecated in TypeScript 6, removed in 7. Since TS 5,
    // `paths` entries resolve relative to this file, which is what we want.
    "paths": {
      "@/*": ["./src/*"],
      "@news/contracts": ["../contracts/src/index.ts"]
    }
  },
  // e2e and the config files are included so type-aware linting covers them
  // too — otherwise ESLint's project service cannot resolve them and reports a
  // parsing error rather than checking the file.
  "include": ["src", "tests", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
